# Generated by Cargo
# will have compiled files and executables
target/
**/*.rs.bk

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock (commented out - executables should track lock file)

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
*.ilk
*.exp

# Temporary files created during builds
*.tmp
*.temp

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
.vim/
# Local AI/assistant settings
.claude/
.claude
settings.local.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Testing and coverage
coverage/
*.profraw
tarpaulin-report.html

# Logs (may contain sensitive debug information)
*.log
logs/
*.log.*
log.txt
debug.log
error.log
trace.log

# Core dumps and crash reports (may contain memory dumps)
core
core.*
*.dmp
*.mdmp
crash-*.log
*.crashlog

# Editor artifacts
*.code-workspace
.project
.classpath
.settings/
.obsidian/

# Temporary files
tmp/
temp/
*.cache

# Build artifacts (non-Cargo)
build/
dist/
out/
Output/
release/

# Configuration files that might contain sensitive information
.env
.env.local
.env.*.local
.env.production
.env.development
*.secret
*.secrets
*.key
*.pem
*.pfx
*.p12
*.cert
*.crt
*.der
*.cer
*.p7b
*.p7c
*.spc
!**/test*.pem
!.github/**/*.pem

# API keys and tokens
api_keys.txt
*.apikey
.api-key
.secret-key

# Application data files that might contain sensitive information
history.json
history.json.enc
*.history
*.history.enc
config.json
secrets.json
identity.json
identity.json.enc
keystore.json
*.db
*.sqlite
*.sqlite3
*.db-journal

# Chat history and user data (CRITICAL - contains encrypted messages)
chats/
data/
userdata/
*.chat
*.messages

# Backup files that might contain sensitive data
*.bak
*.backup
*.old
*~
*.swp
*.swo

# Application runtime directories (may contain sensitive user data)
Downloads/
temp/
runtime/
cache/
.cache/

# User-specific application data directories
AppData/
LocalAppData/
.local/
.config/chat-p2p/
~/Library/Application Support/chat-p2p/

# Private keys and certificates (CRITICAL - never commit these!)
private_key.pem
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.priv
*.private
*.key.pem
*.privatekey

# Password and credential files
passwords.txt
credentials.txt
*.credentials
auth.json
token.json
*.token

# Session and authentication data
session.json
*.session
auth_token
access_token
refresh_token

# Build artifacts that might contain embedded secrets
*.exe
!target/release/*.exe
*.dll
*.so
*.dylib

# Dependency directories (non-Rust)
node_modules/
venv/
__pycache__/

# Distribution / packaging (keep .exe for installer generation)
*.deb
*.dmg
*.msi
*.rpm
*.tar.gz
*.zip
!**/target/release/*.exe

# Rust-specific
**/*.orig
*.rej

# Windows installer outputs
*.iss.bak
!setup.iss

# Debug symbols (optional - uncomment if you want to ignore)
# *.dSYM/
# *.pdb

# Documentation organization: keep archived originals tracked by git
!docs/
!docs/archived/
!docs/archived/*.md.orig

# Security: Prevent accidental commit of test data with real credentials
test_data/real/
test_data/production/
*.real.json
*.prod.json

# Prevent committing local development overrides
local.json
local.*.json
override.json
dev.json

# Memory dumps and debugging artifacts
*.mem
*.heapsnapshot
*.hprof

# Encrypted files that shouldn't be in repo (user data)
*.enc
*.encrypted
*.aes
*.gpg
!docs/**/*.enc  # Allow encrypted docs if needed

# Personal notes and TODO files that might contain sensitive info
NOTES.txt
TODO.private
*.personal
personal/
private/

# Fingerprint databases (user verification data)
fingerprints.json
*.fingerprints
trusted_keys.json

# Network captures and packet dumps
*.pcap
*.pcapng
*.cap

# Profiling and performance data
*.prof
*.perf
perf.data
perf.data.old