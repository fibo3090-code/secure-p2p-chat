party-data/

# ----------------------------------------------------------------------------
# Fuzzing (cargo-fuzz)
# ----------------------------------------------------------------------------
# Corpora and crash artefacts are generated locally and can be large. The
# targets themselves ARE tracked — a fuzz target nobody can find is a fuzz
# target nobody runs.
core/fuzz/corpus/
core/fuzz/artifacts/
core/fuzz/coverage/
core/fuzz/target/

# ----------------------------------------------------------------------------
# Playwright smoke tests
# ----------------------------------------------------------------------------
# Run output only. The config and the specs in desktop/smoke/ ARE tracked.
desktop/test-results/
desktop/playwright-report/
desktop/blob-report/
desktop/.playwright/
